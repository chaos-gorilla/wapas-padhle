# Wapas Padhle (by Scale with Rai) Environment Variables

# Supabase Credentials (optional for local/offline dev; required for cloud sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Telegram Bot Integration (@WapasPadhleBot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_BOT_USERNAME=WapasPadhleBot

# Vercel Cron Secret (Optional, protects the /api/cron/daily-digest route)
CRON_SECRET=your-random-cron-secret-key
